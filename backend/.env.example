# ApplyZen Backend Configuration
APP_NAME=ApplyZen
ENVIRONMENT=development
DEBUG=True
PORT=8000

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min32chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (MongoDB)
MONGODB_URI=mongodb://admin:applyzen_secret_password@localhost:27017/applyzen?authSource=admin
MONGODB_DB_NAME=applyzen

# Cache & Coordination (Redis)
REDIS_URL=redis://localhost:6379/0

# Message Broker (RabbitMQ)
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# AI & LLM Engine (OpenAI / Gemini / Anthropic)
AI_API_KEY=your_openai_or_gemini_api_key_here
AI_MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.1

# Google OAuth & Gmail API
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5173/integrations/callback/google

# Microsoft Graph API & Outlook
MICROSOFT_CLIENT_ID=your_microsoft_client_id
MICROSOFT_CLIENT_SECRET=your_microsoft_client_secret
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5173/integrations/callback/microsoft

# File Storage (Cloudinary / Private Object Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Browser Automation (Playwright)
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_BROWSER_TIMEOUT_MS=30000
BROWSER_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36
